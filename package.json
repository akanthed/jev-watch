{
  "name": "jev-watch",
  "version": "0.1.0",
  "description": "Load test cases from JSON, call the TypeSafe Jev API (directly or via OpenRouter), and catch when answers drift after model updates.",
  "bin": {
    "jev-watch": "bin/jev-watch.js"
  },
  "main": "dist/runner.js",
  "types": "dist/runner.d.ts",
  "files": [
    "bin",
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akanthed/jev-watch.git"
  },
  "bugs": {
    "url": "https://github.com/akanthed/jev-watch/issues"
  },
  "homepage": "https://github.com/akanthed/jev-watch#readme",
  "keywords": [
    "jev",
    "typesafe",
    "openrouter",
    "llm",
    "testing",
    "drift"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.test.json && node --test test-dist/test/*.test.js",
    "bench": "tsc -p tsconfig.test.json && node test-dist/bench/benchmark.js",
    "bench:live": "tsc -p tsconfig.test.json && node test-dist/bench/live-benchmark.js",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@openrouter/sdk": "^1.3.1",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT"
}
